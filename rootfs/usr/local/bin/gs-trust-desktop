#!/bin/sh
# Az asztali parancsikonok megbízhatónak jelölése (a PCManFM-Qt enélkül "!" jelet tesz rájuk).
# A jelző a GIO metaadat-tárban (gvfs) van, ezért a session dbus után kell futnia.
for f in "$HOME"/Desktop/*.desktop; do
  [ -f "$f" ] && gio set "$f" metadata::trust true 2>/dev/null
done
exit 0
