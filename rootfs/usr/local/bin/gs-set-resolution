#!/bin/sh
# Felbontás állítása a headless kimeneten.
# Sunshine-ből hívva a kliens felbontását veszi, "reset" argumentummal az alapértékre áll vissza.
# A frissítési frekvencia legalább GS_MIN_REFRESH (alap: 60 Hz), akkor is, ha a stream 30 FPS-es:
# az emulátorok (és a vsync-es játékok) a kijelző frissítéséhez igazítják a sebességüket, 30 Hz-en
# fél sebességgel futnának, recsegő hanggal. A Sunshine a 60 Hz-es kimenetből is 30 FPS-t kódol.
OUT="${GS_OUTPUT:-HEADLESS-1}"
MIN="${GS_MIN_REFRESH:-60}"
if [ "$1" = "reset" ] || [ -z "$SUNSHINE_CLIENT_WIDTH" ]; then
  W=${DISPLAY_WIDTH:-1920}; H=${DISPLAY_HEIGHT:-1080}; R=${DISPLAY_REFRESH:-60}
else
  W=$SUNSHINE_CLIENT_WIDTH; H=$SUNSHINE_CLIENT_HEIGHT; R=${SUNSHINE_CLIENT_FPS:-60}
fi
[ "$R" -lt "$MIN" ] 2>/dev/null && R=$MIN
exec wlr-randr --output "$OUT" --custom-mode "${W}x${H}@${R}Hz"
