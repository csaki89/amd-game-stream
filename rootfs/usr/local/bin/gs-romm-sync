#!/bin/sh
# romm-sync watch indítása supervisord alatt.
# - párosításig csak vár,
# - a leállítási jelet (TERM) továbbadja a romm-sync-nek, így nem marad árva folyamat,
# - ha a romm-sync kilép (pl. hibás retroarch.cfg, vagy már fut egy példány), vár és újrapróbálja,
#   nem pörög gyors újraindítási hurokban.
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/romm-retroarch-sync/config.ini"
child=""

stop() {
  [ -n "$child" ] && kill -TERM "$child" 2>/dev/null && wait "$child" 2>/dev/null
  exit 0
}
trap stop TERM INT

pause() {  # megszakítható várakozás
  sleep "$1" & child=$!
  wait "$child"
  child=""
}

while [ ! -f "$CFG" ]; do
  echo "[romm-sync] nincs párosítva ($CFG hiányzik) – 'romm-sync pair' után indul"
  pause 300
done

while true; do
  romm-sync watch & child=$!
  wait "$child"; rc=$?
  child=""
  if [ "$rc" -eq 0 ]; then
    echo "[romm-sync] kilépett – 60 mp múlva újraindul"
    pause 60
  else
    echo "[romm-sync] kilépett (kód: $rc) – 5 perc múlva újrapróbálja (pl. retroarch.cfg: network_cmd_enable = \"true\")"
    pause 300
  fi
done
